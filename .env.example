# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# STRIPE_SECRET_KEY: Required for Stripe Checkout.
STRIPE_SECRET_KEY=""

# VITE_STRIPE_PUBLIC_KEY: Required for Stripe frontend.
VITE_STRIPE_PUBLIC_KEY=""

# AMAZON_PAY_MERCHANT_ID: Your Amazon Pay Merchant Identifier.
AMAZON_PAY_MERCHANT_ID=""

# AMAZON_PAY_STORE_ID: Your Amazon Pay Store ID (Client ID).
AMAZON_PAY_STORE_ID=""

# AMAZON_PAY_PUBLIC_KEY_ID: Public Key ID generated in Amazon Seller Central.
AMAZON_PAY_PUBLIC_KEY_ID=""

# AMAZON_PAY_PRIVATE_KEY: RSA private key file content for signing.
AMAZON_PAY_PRIVATE_KEY=""

# AMAZON_PAY_REGION: Region where your seller account resides (na, eu, jp).
AMAZON_PAY_REGION="na"

# AMAZON_PAY_SANDBOX: Use true for Sandbox mode testing.
AMAZON_PAY_SANDBOX="true"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
